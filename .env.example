# Copier ce fichier en .env puis adapter les valeurs : cp .env.example .env
# Valeurs factices uniquement — ne jamais commiter le fichier .env.

# --- Base MySQL ---
MYSQL_DATABASE=ai_jobs
MYSQL_USER=ai_jobs_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Connexion de l'application à la base ---
# "db" = nom du service Compose (résolu par le DNS du réseau Docker)
DB_HOST=db
DB_PORT=3306

# --- Application ---
APP_PORT=8501

# --- Assistant IA (gateway LLM) ---
# Profil « ia » : démarre Ollama et télécharge OLLAMA_MODEL (~400 Mo) au premier lancement.
# Laisser vide pour une stack sans IA (le dashboard affiche alors « IA indisponible »).
COMPOSE_PROFILES=ia
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b
# Facultatif : secours OpenRouter (mode auto) et mode openrouter. Ne jamais commiter de vraie clé.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
