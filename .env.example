# Copier ce fichier en .env puis adapter les valeurs : cp .env.example .env
# Valeurs factices uniquement — ne jamais commiter le fichier .env.

# --- Base MySQL ---
MYSQL_DATABASE=ai_jobs
MYSQL_USER=ai_jobs_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Connexion de l'application à la base ---
# "db" = nom du service Compose (résolu par le DNS du réseau Docker)
DB_HOST=db
DB_PORT=3306

# --- Application ---
APP_PORT=8501
